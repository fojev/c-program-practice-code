#include<stdio.h>
#include<stdlib.h>
struct Node{
	struct Node* prev;
	int data;
	struct Node* next;
}*head=NULL;
void create(int n){
	struct Node* temp,*p;
	int data,i;
	for(i=1;i<=n;i++){
		temp=(struct Node*)malloc(sizeof(struct Node));
		if(temp==NULL){
			printf("could not creat\n");
			return;
		}
		temp->prev=NULL;
		temp->next=NULL;
		printf("Enter data:");
		scanf("%d",&temp->data);
		if(head==NULL||i==1){
			head=temp;
		}else{
			p=head;
			while(p->next!=NULL)p=p->next;
			p->next=temp;
			temp->prev=p;
		}
	}
}
void traverse(){
	struct Node* p=head;
	if(p==NULL){
		printf("Empty list\n");
		return;
	}
	while(p->next!=NULL){
		printf("%d\t",p->data);
		p=p->next;
	}
	printf("%d\n",p->data);
	while(p->prev!=NULL){
		printf("%d\t",p->data);
		p=p->prev;
	}
	printf("%d\n",p->data);
}
