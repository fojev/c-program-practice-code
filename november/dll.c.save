int main(int argc,char*argv[]){
	int option,n,pos;
	while(1){
		printf("1.Create\n");
		printf("2.traverse\n");
		printf("3.insertnode\n");
		printf("4.exit\n");
		scanf("%d",&option);
		switch(option){
				case 1:
					scanf("%d",&n);
					create(n);
					break;
				case 2:
					traverse();
					break;
				case 3:
					printf("Enter data to insert\n");
					scanf("%d",&n);
